# ==========================================
# CONFIGURAÇÃO DO AGENTE RADAR DE VIAGENS 24/7
# ==========================================

# 1. Obtenha seu Token com o @BotFather no Telegram (Gratuito)
TELEGRAM_BOT_TOKEN=

# 2. Obtenha seu Chat ID falando com o @userinfobot no Telegram
TELEGRAM_CHAT_ID=

# 3. Intervalo entre ciclos de varredura (em minutos - padrão: 60)
SCAN_INTERVAL_MINUTES=60

# 4. Percentual de queda abaixo da média para disparar alerta (padrão: 20%)
DISCOUNT_THRESHOLD_PERCENT=20

# 5. Quantidade de meses para frente a serem monitorados (6 a 12 meses)
MONTHS_AHEAD=10

# 6. Caminho do banco de dados SQLite local
DB_PATH=radar_viagens.db
